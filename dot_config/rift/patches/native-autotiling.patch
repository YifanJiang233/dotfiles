+#[test]
+fn same_display_space_replacement_after_wake_preserves_workspace_state() {
+    let (mut apps, mut reactor) = test_context_with_workspace_count(3);
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let old_space = SpaceId::new(1);
+    let new_space = SpaceId::new(2);
+    let windows = make_windows(3);
+    let window_ids: Vec<_> = (1..=3).map(|idx| WindowId::new(1, idx)).collect();
+
+    apps.make_app_and_settle_on_screen(&mut reactor, screen, old_space, 1, windows);
+
+    let old_workspaces = reactor.test_workspace_ids(old_space);
+    let expected_indices = [2usize, 1, 2];
+    for (wid, &index) in window_ids.iter().zip(expected_indices.iter()) {
+        assert!(reactor.assign_test_window_to_workspace(old_space, *wid, old_workspaces[index]));
+    }
+    assert!(reactor.set_test_active_workspace(old_space, old_workspaces[2]));
+    reactor.discover_test_windows(1, vec![], window_ids.clone());
+    let layout_before = test_layout(&mut reactor, old_space, screen);
+    let tree_before = reactor
+        .query_layout_state(Some(old_space.get()), None)
+        .expect("active workspace layout state")
+        .container_tree;
+
+    reactor.handle_event(Event::SystemWillSleep);
+    reactor.handle_event(Event::SystemWoke);
+
+    let mut recovered = forwarded_space_state(make_screen_snapshots(
+        vec![screen],
+        vec![Some(new_space)],
+    ));
+    recovered.releases_lifecycle_refresh_quarantine = true;
+    recovered.space_remaps.push((old_space, new_space));
+    for wid in &window_ids {
+        recovered
+            .active_window_spaces
+            .insert(reactor.test_window_server_id(*wid), new_space);
+    }
+    reactor.handle_event(Event::SpaceStateChanged(recovered));
+
+    let new_workspaces = reactor.test_workspace_ids(new_space);
+    assert_eq!(new_workspaces, old_workspaces);
+    for (wid, &expected_index) in window_ids.iter().zip(expected_indices.iter()) {
+        let actual = reactor
+            .test_workspace_for_window(new_space, *wid)
+            .expect("recovered window should retain a workspace assignment");
+        assert_eq!(actual, old_workspaces[expected_index]);
+    }
+    assert_eq!(
+        reactor.layout_manager.layout_engine.active_workspace_idx(new_space),
+        Some(2),
+        "wake recovery must retain the active virtual workspace"
+    );
+    assert_eq!(
+        reactor.layout_manager.layout_engine.active_workspace(new_space),
+        Some(old_workspaces[2]),
+        "wake recovery must retain the active workspace identity"
+    );
+    let tree_after = reactor
+        .query_layout_state(Some(new_space.get()), None)
+        .expect("recovered active workspace layout state")
+        .container_tree;
+    assert_eq!(tree_after, tree_before, "wake recovery must retain the layout tree");
+    assert_eq!(
+        test_layout(&mut reactor, new_space, screen),
+        layout_before,
+        "wake recovery must retain the active workspace layout"
+    );
+}
