+            let mut engine = test_engine();
+            let windows = (1..=member_count)
+                .map(|index| WindowId::new(68, index))
+                .collect::<Vec<_>>();
+            for window in &windows {
+                engine.scratchpad.add(*window);
+            }
+            let stale = windows[stale_index as usize];
+            engine.scratchpad.shown = Some(stale);
+
+            engine.discard_candidates(vec![stale]);
+
+            let expected = windows
+                .into_iter()
+                .filter(|window| *window != stale)
+                .collect::<Vec<_>>();
+            assert_eq!(engine.scratchpad.members, expected);
+            assert_eq!(engine.scratchpad.shown, None);
+        }
+    }
+}
