+    let screens = |left, right: Option<SpaceId>| {
+        let mut result = vec![make_screen_with(1, "left", 0.0, 1000.0, Some(left))];
+        if let Some(right) = right {
+            result.push(make_screen_with(2, "right", 1000.0, 1000.0, Some(right)));
+        }
+        result
+    };
+    actor.handle_event(Event::ScreenParametersChanged(screens(old_left, Some(old_right)), converter));
+    let _ = recv_wm(&mut wm_rx);
+    actor.handle_event(Event::SystemWillSleep);
+    actor.handle_event(Event::SystemDidWake);
+    actor.set_test_display_space_inventory(HashMap::from_iter([
+        ("left".to_string(), vec![new_left]),
+    ]));
+    actor.handle_event(Event::ScreenParametersChanged(screens(new_left, None), converter));
+    assert_no_wm_event(&mut wm_rx);
+    actor.handle_event(Event::ScreenParametersChanged(screens(new_left, None), converter));
+    match recv_wm(&mut wm_rx) {
