# This is a demo config to show some of the most important commands more easily.
# This is meant to be changed and configured, as it is intentionally kept sparse.
# For a more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
source "$CONFIG_DIR/styles/style.sh"

# ##### Bar Appearance #####

# Setting up the general bar appearance and default values
sketchybar --bar "${bar_config[@]}" \
	--default \
	"${icon_defaults[@]}" \
	"${label_defaults[@]}" \
	"${background_defaults[@]}" \
	"${popup_defaults[@]}"



##### Adding Left Items #####
# We add some regular items to the left side of the bar
# only the properties deviating from the current defaults need to be set

# source $ITEM_DIR/apple.sh
# Aerospace integration remains available, but Rift owns the active workspace bar.
# source $ITEM_DIR/aerospace.sh
source $ITEM_DIR/rift_workspaces.sh

##### Adding Center Items #####
# We add some regular items to the center of the bar
# source $ITEM_DIR/lyric.sh
# The original front_app item remains unchanged but is not loaded alongside Rift's window item.
# source $ITEM_DIR/front_app.sh
source $ITEM_DIR/rift_front_app.sh


##### Adding Right Items #####

# Remove right-side items from the previous layout before adding the current
# module set. SketchyBar keeps existing items across config reloads.
sketchybar --remove battery >/dev/null 2>&1
sketchybar --remove volume >/dev/null 2>&1
sketchybar --remove weather >/dev/null 2>&1
sketchybar --remove bluetooth >/dev/null 2>&1
sketchybar --remove network >/dev/null 2>&1
sketchybar --remove clock >/dev/null 2>&1
sketchybar --remove '/^network\.(up|down)$/' >/dev/null 2>&1
sketchybar --remove '/^svim\./' >/dev/null 2>&1
sketchybar --remove '/^(weather|bluetooth|volume|network)\.tooltip\.line\.[0-9]+$/' >/dev/null 2>&1

sketchybar --add event weather_refresh
source $ITEM_DIR/clock.sh
source $ITEM_DIR/network.sh
source $ITEM_DIR/volume.sh
source $ITEM_DIR/bluetooth.sh
source $ITEM_DIR/weather.sh

# The below command is only needed at the end of the initial configuration to
# force all scripts to run the first time, it should never be run in an item script.
sketchybar --hotload on
sketchybar --update

echo  "SketchyBar has been configured."   
